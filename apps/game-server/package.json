{
  "name": "@townhall/game-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "tsc",
    "start": "node --env-file=../../.env dist/server.js",
    "test": "node --env-file=../../.env --import tsx --test src/rooms/WorldRoom.test.ts src/services/worldService.test.ts",
    "test:e2e": "node --env-file=../../.env --import tsx --test src/multiplayer.e2e.test.ts src/lifecycle.e2e.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@colyseus/schema": "^2.0.0",
    "@colyseus/tools": "^0.15.35",
    "@supabase/supabase-js": "^2.119.0",
    "@townhall/shared": "workspace:*",
    "colyseus": "^0.15.42",
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "colyseus.js": "0.15.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
