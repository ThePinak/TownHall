# TownHall Environment Variables Template

# Game Server Configuration
PORT=2567
NODE_ENV=development

# Supabase Authentication & PostgreSQL Configuration
# (When omitted, the server operates in local development / offline test mode)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Client Frontend
VITE_GAME_SERVER_URL=ws://localhost:2567
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# LiveKit WebRTC SFU Configuration (Milestone 5)
# (When omitted, the server operates in simulated voice mode for zero-dependency local dev/tests)
LIVEKIT_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

